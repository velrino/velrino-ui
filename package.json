{
  "name": "@velrino/ui",
  "version": "0.0.1",
  "private": true,
  "description": "Themeable React primitives, sci-fi dialog frames and a reusable design-system gallery.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velrino/velrino-ui.git"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/test.mjs",
    "validate": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build"
  },
  "peerDependencies": {
    "react": ">=19.1.0 <20",
    "react-dom": ">=19.1.0 <20"
  },
  "dependencies": {
    "clsx": "2.1.1"
  },
  "devDependencies": {
    "@types/node": "20.19.39",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "prettier": "3.6.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
