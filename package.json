{
  "name": "@velrino/ui",
  "version": "0.0.1",
  "private": true,
  "description": "Accessible, themeable React components with optional sci-fi surfaces and a reusable design-system gallery.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./showcase": {
      "types": "./dist/showcase/index.d.ts",
      "import": "./dist/showcase/index.js"
    },
    "./messages": {
      "types": "./dist/showcase/messages/index.d.ts",
      "import": "./dist/showcase/messages/index.js"
    },
    "./showcase.css": "./dist/showcase.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velrino/velrino-ui.git"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/test.mjs",
    "validate": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build",
    "demo:dev": "vite examples/showcase --host 127.0.0.1 --port 4321 --strictPort",
    "demo:build": "vite build examples/showcase",
    "test:browser": "playwright test"
  },
  "peerDependencies": {
    "react": ">=19.1.0 <20",
    "react-dom": ">=19.1.0 <20"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-tabs": "1.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/jsdom": "27.0.0",
    "@types/node": "20.19.39",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.6.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
